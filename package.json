{
  "name": "pixima",
  "description": "Todas as imagens de qualquer site num só painel. Copie, converta e baixe em ZIP em segundos, 100% privado.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "vue-tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lucide/vue": "^1.55.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "driver.js": "^1.9.0",
    "fflate": "^0.8.3",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.29",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-vue": "^1.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vue-tsc": "^3.2.5",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  },
  "license": "MIT",
  "author": "Kauã F. N. Rodrigues",
  "homepage": "https://github.com/rodrigueskaua/pixima#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodrigueskaua/pixima.git"
  },
  "bugs": {
    "url": "https://github.com/rodrigueskaua/pixima/issues"
  },
  "keywords": [
    "browser-extension",
    "image-downloader",
    "image-converter",
    "chrome",
    "firefox",
    "wxt",
    "vue"
  ]
}
